{
  "name": "kugou-dashboard-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "酷狗统筹面板桌面应用外壳（Electron）",
  "author": "knoedele10",
  "main": "dist/Main.js",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "pnpm run build && node Scripts/RunElectron.mjs",
    "dev": "pnpm run build && node Scripts/RunElectron.mjs --dev",
    "test": "pnpm run typecheck && pnpm run build && node --test Tests/*.mjs",
    "prepare:bundle": "python Scripts/PrepareBundle.py",
    "pack": "pnpm run build && pnpm run prepare:bundle && electron-builder --dir",
    "dist": "pnpm run build && pnpm run prepare:bundle && electron-builder --win"
  },
  "build": {
    "appId": "com.kugoudashboard.desktop",
    "productName": "酷狗统筹面板",
    "directories": {
      "output": "release",
      "buildResources": "Assets"
    },
    "asarUnpack": [
      "Resources/BackendRunner.py",
      "Assets/**/*"
    ],
    "files": [
      "dist/**/*",
      "Resources/**/*",
      "Assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../Template/dist",
        "to": "frontend"
      },
      {
        "from": ".bundle/backend",
        "to": "backend"
      },
      {
        "from": ".bundle/python",
        "to": "python"
      }
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "icon": "Assets/Icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "酷狗统筹面板"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "typescript": "~5.7.3"
  }
}
